# Cloudflare Account ID
CF_ACCOUNT_ID=e809b1129ec4b6f69520858ac79b2095

# Cloudflare AI Gateway Route URLs (省略時はアカウントIDとGateway IDから自動生成)
# ※ 対話中の分析官AIは Workers AI (@cf/cloudflare/clef-flash) 固定で動作します
# 最終性格分析レポート用 Route (dynamic/llm5-analyst)
CF_AI_GATEWAY_ANALYST_URL=https://gateway.ai.cloudflare.com/v1/e809b1129ec4b6f69520858ac79b2095/llm5/compat/chat/completions
# 質問係チャット用 Route (dynamic/llm5)
CF_AI_GATEWAY_CHAT_URL=https://gateway.ai.cloudflare.com/v1/e809b1129ec4b6f69520858ac79b2095/llm5/compat/chat/completions

# Cloudflare AI Gateway Token / Cloudflare API Token (Workers AI実行権限を持つトークン)
# ※ Pages Functions環境では [ai] バインディングによりトークン不要で動作しますが、
#    HTTP Direct / 外部Gateway経由でWorkers AIを呼ぶ場合やAuthenticated Gateway有効時に使用します。
CF_AIG_TOKEN=
CLOUDFLARE_API_TOKEN=

# 管理画面用アクセスパスワード (管理者がデータを閲覧・ダウンロードするための認証キー)
ADMIN_PASSWORD=llm5admin

